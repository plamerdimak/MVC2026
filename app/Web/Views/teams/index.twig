{% extends 'layout.twig' %}

{% block title %}Equipes{% endblock %}

{% block content %}
    <h1>Equipes</h1>
    <p><a class="button" href="{{ url('/teams/create') }}">Nouvelle equipe</a></p>

    {% if teams is empty %}
        <p>Aucune equipe.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Membres</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for team in teams %}
                    <tr>
                        <td>{{ team.id }}</td>
                        <td>{{ team.name }}</td>
                        <td>{{ team.members_count }}</td>
                        <td><a href="{{ url('/teams/' ~ team.id) }}">Voir l'equipe</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
